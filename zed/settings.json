// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  // assistant
  "assistant": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "version": "2",
    "dock": "right",
    "default_width": 1200
  },

  // telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  // theme
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Tokyo Night"
  },

  // editor
  "vim_mode": true,
  "cursor_blink": false,
  "relative_line_numbers": true,
  "scrollbar": { "show": "never" },
  "vertical_scroll_margin": 8,
  "tab_bar": { "show": true }, // change this when comfortable with tabs
  "use_autoclose": false, // auto-close brackets, parentheses, etc.
  "use_auto_surround": false, // auto-surround selected text with brackets, parentheses, etc.

  // fonts & themes
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_family": "Hack Nerd Font",
  "buffer_line_height": { "custom": 1.5 },

  // completion
  "completion_documentation_secondary_query_debounce": 300,
  "auto_signature_help": true,

  // terminal
  "terminal": {
    // "default_width": 640, // Default width when the terminal is docked to the left or right.
    "default_height": 600, // Default height when the terminal is docked to the bottom.
    "font_family": "Hack Nerd Font",
    "font_size": 16,
    "line_height": { "custom": 1.5 }
    // "line_height": "comfortable"
  },

  // other
  "restore_on_startup": "none",
  "preferred_line_length": 80,
  "soft_wrap": "prefer_line", // "preferred_line_length"
  "show_wrap_guides": true,
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ]
}
