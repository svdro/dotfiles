// Zed keymap

[
  // Disable conflicting keybindings
  {
    "bindings": {
      "shift-escape": null, // disable workspace::ToggleZoom
      "ctrl-b": null, // disable workspace::ToggleLeftDock
      "ctrl-z": null, // disable editor::Undo
      "ctrl-w": null // disable default behavior
    }
  },

  // Tab Key Behavior
  {
    "context": "Picker > Editor",
    "bindings": {
      "tab": "menu::SelectNext",
      "shift-tab": "menu::SelectPrev"
    }
  },

  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrev"
    }
  },

  // Navigation
  {
    "context": "VimControl && !menu || MarkdownPreview || KeyContextView",
    "bindings": {
      // navigate between tabs
      "space t n": "pane::ActivateNextItem",
      "space t p": "pane::ActivatePrevItem",

      // move tabs (vimium style)
      "< <": "pane::SwapItemLeft",
      "> >": "pane::SwapItemRight"

      // TODO: figure out what to do for "open tab" and "close tab" to make it feel intuitive
      // "space t o": ["workspace::NewFileInDirection", "Right"],
      // "space t c": ["pane::CloseActiveItem", { "saveIntent": "skip" }]
    }
  },

  {
    // NOTE: normally Dock is a parent context of Terminal and AssistantPanel, but that doesn't seem to be the
    // case in fullscreen mode, so we need to include them explicitly.
    "context": "VimControl && !menu || Dock || MarkdownPreview || KeyContextView || Terminal || AssistantPanel",
    "bindings": {
      // toggle zoom
      "ctrl-w z": "workspace::ToggleZoom",

      // navigate between panes
      "ctrl-w h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-w l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-w k": ["workspace::ActivatePaneInDirection", "Up"],
      "ctrl-w j": ["workspace::ActivatePaneInDirection", "Down"],

      // "ctrl-w v": null,
      "ctrl-w v": "pane::SplitRight",
      "ctrl-w s": "pane::SplitDown",

      "ctrl-h": ["workspace::ActivatePaneInDirection", "Left"],
      "ctrl-l": ["workspace::ActivatePaneInDirection", "Right"],
      "ctrl-k": ["workspace::ActivatePaneInDirection", "Down"],
      "ctrl-j": ["workspace::ActivatePaneInDirection", "Up"]
    }
  },

  // Copilot & Assistant
  {
    "context": "vim_mode == insert && inline_completion",
    "bindings": {
      "alt-]": "editor::NextInlineCompletion",
      "alt-[": "editor::PreviousInlineCompletion",
      "j k": "editor::AcceptPartialInlineCompletion",
      "j j": "editor::AcceptInlineCompletion"
    }
  },

  {
    "context": "vim_mode == insert",
    "bindings": {
      "j J": "editor::ShowInlineCompletion"
    }
  },

  {
    "context": "Editor && VimControl && !menu || EmptyPane",
    "bindings": {
      "space a A": "workspace::ToggleRightDock",
      "space a a ": "assistant::ToggleFocus",
      "space a q": "assistant::QuoteSelection", // TODO: move this to a different context
      "space a I": "assistant::InlineAssist"
    }
  },

  {
    "context": "ContextEditor > Editor && VimControl && !menu",
    "bindings": {
      // "ctrl-k l": "assistant::DeployPromptLibrary",
      "space a m": "assistant::ToggleModelSelector",
      "space a h": "assistant::DeployHistory",
      "space a r": "assistant::CycleMessageRole",
      "space a n": "assistant::NewContext"
    }
  },

  {
    "context": "AssistantPanel > Pane > Picker > Editor",
    "bindings": {
      "escape": ["pane::CloseActiveItem", { "saveIntent": "skip" }]
    }
  },

  // Search
  {
    "context": "VimControl && !menu || MarkdownPreview || ProjectPanel || EmptyPane",
    "bindings": {
      "space f f": "file_finder::Toggle",
      "space f b": "tab_switcher::Toggle",
      "space f s": "pane::DeploySearch"
    }
  },

  {
    "context": "ProjectSearchBar",
    "bindings": {
      "escape": ["pane::CloseActiveItem", { "saveIntent": "skip" }]
    }
  },

  // Excerpts (eg. project search or diagnostics show multiple files in excerpts)
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      "g space": "editor::OpenExcerpts", // this is the default binding in vim mode
      "shift-enter": "editor::ExpandExcerpts", // this is the default binding
      "space space k": "editor::ExpandExcerptsUp",
      "space space j": "editor::ExpandExcerptsDown"
    }
  },

  // Git
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      "space h n": "editor::GoToHunk",
      "space h p": "editor::GoToHunk",
      "space h P": "editor::ToggleHunkDiff",
      "space h d": "editor::ExpandAllHunkDiffs",
      "space h r": "editor::RevertSelectedHunks",
      "space h B": "editor::ToggleGitBlame",
      "space h b": "editor::ToggleGitBlameInline"
    }
  },

  // Comments (nerd commenter)
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      // nerd commenter
      "space c c": "vim::ToggleComments",
      "space c u": "vim::ToggleComments",
      "space c p": "editor::Copy", // workaround because yank deselects the text in visual mode
      "space c y": ["workspace::SendKeystrokes", "space c p space c c"]
    }
  },

  // Multiple Cursors
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-shift-k": "editor::AddSelectionAbove",
      "ctrl-shift-j": "editor::AddSelectionBelow"
    }
  },

  // Misc Vim Keybindings
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      // misc
      "shift-k": "editor::Hover",
      "space F F": "editor::Format",
      "space r n": "editor::Rename",
      "space p": "outline::Toggle",
      "space v": "editor::GoToDefinitionSplit",
      "g D": "editor::GoToDefinitionSplit", // maybe this is more intuitive

      // diagnostics
      "space d n": "editor::GoToDiagnostic",
      "space d p": "editor::GoToPrevDiagnostic",
      "space d d": "diagnostics::Deploy",

      // go to
      "g r": "editor::FindAllReferences"
    }
  },

  {
    "context": "VimControl && !menu",
    "bindings": {
      // tree-sitter (see which one is better)
      "g k": "editor::SelectLargerSyntaxNode",
      "g j": "editor::SelectSmallerSyntaxNode",
      "space k": "editor::SelectLargerSyntaxNode",
      "space j": "editor::SelectSmallerSyntaxNode"
    }
  },

  // Project Panel
  {
    "context": "VimControl && !menu || MarkdownPreview || ProjectPanel || EmptyPane",
    "bindings": {
      "space e E": "workspace::ToggleLeftDock",
      "space e e": "project_panel::ToggleFocus"
    }
  },

  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // "f2": "project_panel::Rename",
      "r": "project_panel::Rename",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "d": ["project_panel::Delete", { "skip_prompt": false }]
    }
  },

  // Markdown Preview
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space m d": "markdown::OpenPreview"
    }
  },

  {
    "context": "MarkdownPreview",
    "bindings": {
      ":": "command_palette::Toggle",
      "q": "pane::CloseActiveItem"
    }
  },

  // Terminal ( must be last to override other bindings )
  {
    "bindings": {
      "ctrl-z": "workspace::ToggleBottomDock" // toggle terminal
    }
  },

  {
    "context": "VimControl && !menu || MarkdownPreview || ProjectPanel || ContextEditor > Editor && VimControl && !menu || EmptyPane",
    "bindings": {
      "space t T": "workspace::ToggleBottomDock", // toggle terminal
      "space t t": "terminal_panel::ToggleFocus" // focus terminal
    }
  },

  {
    "context": "Terminal",
    "bindings": {
      // reset space as leader key
      "space": null,

      // tmux-like key bindings
      "ctrl-b c": "workspace::NewTerminal",
      "ctrl-b n": "pane::ActivateNextItem",
      "ctrl-b p": "pane::ActivatePrevItem",
      "ctrl-b x y": "pane::CloseActiveItem",
      "ctrl-b d": "workspace::ToggleBottomDock",

      // pseudo fg command in terminal to bring editor back into focus
      "f g enter": "workspace::ToggleBottomDock",

      // the terminal doesn't have vim modes, so mapping the command pallette to ":"
      // is impractical. Instead use key bindings that simulate vim commands (for muscle memory)
      ": q enter": "pane::CloseActiveItem",
      ": q ! enter": "pane::CloseActiveItem"
    }
  }
]
