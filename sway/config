### =============== definitions =============================================

# probably don't need this
# include /etc/sway/config-vars.d/*

include $HOME/.config/sway/themes/catppuccin_mocha

set $mod Mod4
set $mod2 Mod1

set $left h
set $down j
set $up k
set $right l

set $term alacritty

set $wallpaper $HOME/.config/sway/images/wallpaper_animne1.jpg
set $lockscreen $HOME/.config/sway/images/wallpaper_animne1.jpg

### =============== launcher ================================================

# Note: we're passing this to "swaymsg exec --" to ensure we're in the right workspace
set $menu dmenu_path | wmenu -l 5 -b | xargs swaymsg exec --

set $toficonf $HOME/.config/sway/tofi/config
set $tofifont "/usr/share/fonts/hack/HackNerdFontMono-Bold.ttf"
set $tofi tofi-drun \
    --config $toficonf \
    --font $tofifont \
    --selection-color  "$color_blue" \
    --selection-match-color "$color_red" \
    --text-color "$color_fg"

# Note: we're passing this to "swaymsg exec --" to ensure we're in the right workspace
set $drun $tofi | xargs swaymsg exec --

### =============== outputs =================================================

# wallpaper
output * bg $wallpaper fill
#output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

# Clamshell mode for laptops (list outputs: swaymsg -t get_outputs)
set $laptop eDP-1
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

# Manually enable/disable laptop screen in case of issues
bindsym $mod+$mod2+e exec swaymsg output $laptop enable
bindsym $mod+$mod2+d exec swaymsg output $laptop disable

# put laptop screen on the correct side
output $laptop pos 0 0 res 2880x1800

### =============== appearance ==============================================
#
# client.focused        $lavender         $lavender         $base            $base            $lavender
client.focused          $color_blue     $color_bg_lighter $color_fg        $color_blue    $color_blue
client.focused_inactive $color_bg_lighter $color_bg_light   $color_fg_dim    $color_bg_lighter $color_bg_lighter
client.unfocused        $color_bg_light   $color_bg_main    $color_fg_dimmer $color_bg_light  $color_bg_light
client.urgent           $color_red    $color_bg_light   $color_fg        $color_red   $color_red

# client.focused $lavender $lavender $base $base $lavender
default_border pixel 2

# gaps
gaps inner 10
gaps outer 0
# smart_gaps on

### =============== bar =====================================================

# bar {
#     position top
#     status_command i3status
# }

bar swaybar_command waybar


### =============== notifications ===========================================

# Ensure dunst is not running before starting swaync
exec killall dunst; swaync

# Notifications mode
set $mode_notifications "Notifications: (c) clear all, (d) toggle dnd, (r) reload"

mode $mode_notifications {
    bindsym d exec swaync-client -d -sw
    bindsym c exec swaync-client -C -sw
    bindsym r exec swaync-client -R -sw; exec swaync-client -rs -sw
    bindsym Escape exec swaync-client -cp -sw; mode "default"
    bindsym $mod+Shift+n exec swaync-client -cp -sw; mode "default"
}

bindsym $mod+Shift+n mode $mode_notifications; exec swaync-client -op -sw


### =============== system ==================================================

# Lockscreen flags
# -f daemonize
# -F show failed attempts
# -i image
# -e ignore empty password
# -k show keyboard layout

# Lock and turn off the screen when idle
exec swayidle -w \
    timeout 300 "swaylock -fFek -i $lockscreen" \

    # Note: this currently crashes the system after a while. debug later
    #timeout 1800 'swaymsg "output * dpms off"' \
      #resume 'swaymsg "output * dpms on"' \
    #before-sleep 'swaylock -f -i $lockscreen'


# System mode
set $mode_system "System: (l) lock, (r) reboot, (CTRL+s) shutdown"
#set $mode_system "System: (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (CTRL+s) shutdown"

mode $mode_system {
    bindsym l exec swaylock -fFek -i $lockscreen, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym Ctrl+s exec systemctl poweroff -i, mode "default"

    ## Note: these currently crashes the system. debug later
    #bindsym e exec swaymsg exit, mode "default"
    #bindsym s exec swaylock -fFek -i $lockscreen && systemctl suspend, mode "default"
    #bindsym h exec swaylock -fFek -i $lockscreen && systemctl hibernate, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+$mod2+BackSpace mode "default"
}

bindsym $mod+$mod2+BackSpace mode $mode_system


### =============== influde =================================================
include $HOME/.config/sway/config.d/*
include /etc/sway/config.d/*
